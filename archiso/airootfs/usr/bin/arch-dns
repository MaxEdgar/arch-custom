#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════
# arch-dns — DNS Configuration Utility
# Manages DNS settings for the system.
# ═══════════════════════════════════════════════════════════════════
set -euo pipefail

RESOLVED_CONF="/etc/systemd/resolved.conf.d/dns.conf"

# ── Colors ────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

info() { echo -e "${GREEN}→${NC} $*"; }
warn() { echo -e "${YELLOW}!${NC} $*"; }
die()  { echo -e "${RED}ERROR:${NC} $*"; exit 1; }

usage() {
    echo -e "${BOLD}arch-dns${NC} — DNS Configuration"
    echo ""
    echo "Usage: arch-dns [command]"
    echo ""
    echo "Commands:"
    echo "  cloudflare    Set Cloudflare DNS (1.1.1.1, 1.0.0.1)"
    echo "  google        Set Google DNS (8.8.8.8, 8.8.4.4)"
    echo "  quad9         Set Quad9 DNS (9.9.9.9)"
    echo "  automatic     Use DHCP-provided DNS"
    echo "  custom <1> <2>  Set custom DNS servers"
    echo "  show          Show current DNS configuration"
    echo "  test          Test DNS resolution"
    echo "  help          Show this help"
    echo ""
}

apply_dns() {
    local primary="$1"
    local fallback="${2:-}"

    mkdir -p "$(dirname "$RESOLVED_CONF")"

    cat > "$RESOLVED_CONF" << EOF
# Arch Custom — DNS Configuration
# Generated by arch-dns on $(date -Iseconds)

[Resolve]
DNS=${primary}${fallback:+ ${fallback}}
Domains=~.
Cache=yes
DNSStubListener=yes
EOF

    # Restart resolved if running
    if systemctl is-active systemd-resolved &>/dev/null 2>&1; then
        sudo systemctl restart systemd-resolved
        info "Restarted systemd-resolved"
    fi

    info "DNS configured: $primary${fallback:+, $fallback}"
}

cmd_cloudflare() {
    apply_dns "1.1.1.1" "1.0.0.1"
}

cmd_google() {
    apply_dns "8.8.8.8" "8.8.4.4"
}

cmd_quad9() {
    apply_dns "9.9.9.9" "149.112.112.112"
}

cmd_automatic() {
    rm -f "$RESOLVED_CONF" 2>/dev/null || true
    if systemctl is-active systemd-resolved &>/dev/null 2>&1; then
        sudo systemctl restart systemd-resolved
    fi
    info "DNS set to automatic (DHCP)"
}

cmd_custom() {
    local primary="${1:-}"
    local fallback="${2:-}"
    [[ -z "$primary" ]] && die "Primary DNS server required"
    apply_dns "$primary" "$fallback"
}

cmd_show() {
    echo -e "\n${BOLD}Current DNS Configuration:${NC}"
    echo ""

    # Show resolved config
    if [[ -f /run/systemd/resolve/resolv.conf ]]; then
        echo -e "${CYAN}Active resolvers:${NC}"
        grep "^nameserver" /run/systemd/resolve/resolv.conf 2>/dev/null || echo "  (none)"
    fi

    echo ""
    echo -e "${CYAN}Configured DNS:${NC}"
    if [[ -f "$RESOLVED_CONF" ]]; then
        grep "^DNS=" "$RESOLVED_CONF" 2>/dev/null | sed 's/DNS=/  /'
    else
        echo "  Automatic (DHCP)"
    fi

    echo ""
    echo -e "${CYAN}Current system resolv.conf:${NC}"
    grep "^nameserver" /etc/resolv.conf 2>/dev/null | head -3 || echo "  (none)"
}

cmd_test() {
    echo -e "\n${BOLD}Testing DNS Resolution:${NC}"
    echo ""

    local domains=("archlinux.org" "google.com" "cloudflare.com")
    for domain in "${domains[@]}"; do
        printf "  %-20s" "$domain"
        if host "$domain" &>/dev/null 2>&1; then
            local ip
            ip=$(host "$domain" 2>/dev/null | grep "has address" | head -1 | awk '{print $NF}')
            echo -e "${GREEN}✓${NC} $ip"
        else
            echo -e "${RED}✗${NC} Failed"
        fi
    done

    echo ""
    echo -e "${CYAN}Latency test (1.1.1.1):${NC}"
    if ping -c 3 -W 2 1.1.1.1 &>/dev/null; then
        ping -c 3 -W 2 1.1.1.1 2>/dev/null | tail -1
    else
        echo -e "  ${RED}Cannot reach 1.1.1.1${NC}"
    fi
}

# ── Main ──────────────────────────────────────────────────────────
case "${1:-help}" in
    cloudflare) cmd_cloudflare ;;
    google)     cmd_google ;;
    quad9)      cmd_quad9 ;;
    automatic)  cmd_automatic ;;
    custom)     cmd_custom "${2:-}" "${3:-}" ;;
    show)       cmd_show ;;
    test)       cmd_test ;;
    help|-h|--help) usage ;;
    *)
        die "Unknown command: $1. Run 'arch-dns help' for usage."
        ;;
esac
