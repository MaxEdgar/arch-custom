#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════
# system-setup — Interactive System Configuration TUI
# Keyboard-only navigation, modular, lightweight.
# ═══════════════════════════════════════════════════════════════════
set -uo pipefail

# ── Source modules ────────────────────────────────────────────────
_LIBDIR="/usr/lib/arch-custom"
source "$_LIBDIR/lib/arch-custom/cli/config.sh" 2>/dev/null || \
    source "$_LIBDIR/cli/config.sh" 2>/dev/null || true

# ── Colors ────────────────────────────────────────────────────────
C_RESET='\033[0m'
C_BOLD='\033[1m'
C_DIM='\033[2m'
C_RED='\033[1;31m'
C_GREEN='\033[1;32m'
C_YELLOW='\033[1;33m'
C_BLUE='\033[1;34m'
C_CYAN='\033[1;36m'
C_WHITE='\033[1;37m'
C_GRAY='\033[2m'
C_REVERSE='\033[7m'

# ── Terminal ──────────────────────────────────────────────────────
_setup_init() {
    stty -echo -icanon min 0 time 0 2>/dev/null || true
    printf '\033[?25l'  # Hide cursor
    printf '\033[?1049h'  # Alt screen
}

_setup_cleanup() {
    printf '\033[?25h'  # Show cursor
    printf '\033[?1049l'  # Normal screen
    stty sane 2>/dev/null || true
}

trap '_setup_cleanup' EXIT INT TERM

# ── Drawing ───────────────────────────────────────────────────────
clear_screen() {
    printf '\033[2J\033[H'
}

draw_box() {
    local title="$1" row=${2:-1} col=${3:-1} width=${4:-50} height=${5:-20}

    # Top
    _move_to "$row" "$col"
    printf "${C_CYAN}┌─${C_BOLD} %s ${C_RESET}${C_CYAN}" "$title"
    local tlen=${#title}
    local padding=$((width - tlen - 4))
    printf '─%.0s' $(seq 1 $padding 2>/dev/null || true)
    printf "┐${C_RESET}"

    # Middle rows
    local i
    for ((i=1; i<height-2; i++)); do
        _move_to $((row+i)) "$col"
        printf "${C_CYAN}│${C_RESET}"
        printf '%*s' $((width-2)) ''
        printf "${C_CYAN}│${C_RESET}"
    done

    # Bottom
    _move_to $((row+height-1)) "$col"
    printf "${C_CYAN}└"
    printf '─%.0s' $(seq 1 $((width-2)) 2>/dev/null || true)
    printf "┘${C_RESET}"
}

_move_to() {
    printf "\033[%d;%dH" "$1" "$2"
}

# ── Input ─────────────────────────────────────────────────────────
read_key() {
    local key
    key=$(dd bs=1 count=1 2>/dev/null || echo "")
    [[ -z "$key" ]] && { echo ""; return; }

    local ord
    ord=$(printf '%d' "'$key" 2>/dev/null || echo "0")

    case "$ord" in
        27)
            local s1 s2
            s1=$(dd bs=1 count=1 -t 0.05 2>/dev/null || echo "")
            s2=$(dd bs=1 count=1 -t 0.05 2>/dev/null || echo "")
            [[ "$s1" == "[" && "$s2" == "A" ]] && { echo "up"; return; }
            [[ "$s1" == "[" && "$s2" == "B" ]] && { echo "down"; return; }
            [[ "$s1" == "[" && "$s2" == "C" ]] && { echo "right"; return; }
            [[ "$s1" == "[" && "$s2" == "D" ]] && { echo "left"; return; }
            [[ "$s1" == "[" && "$s2" == "Z" ]] && { echo "shift-tab"; return; }
            echo "escape"
            ;;
        9)  echo "tab" ;;
        10|13) echo "enter" ;;
        127|8) echo "backspace" ;;
        3)  echo "ctrl-c" ;;
        113) echo "q" ;;
        *)
            if ((ord >= 32 && ord <= 126)); then
                echo "$key"
            else
                echo ""
            fi
            ;;
    esac
}

# ── Menu Renderer ─────────────────────────────────────────────────
draw_menu() {
    local title="$1"
    shift
    local -a items=("$@")
    local selected=$MENU_SELECTED
    local width=50
    local height=$(( ${#items[@]} + 6 ))

    clear_screen
    draw_box "$title" 2 2 "$width" "$height"

    local i
    for ((i=0; i<${#items[@]}; i++)); do
        _move_to $((4+i)) 4
        if [[ $i -eq $selected ]]; then
            printf "${C_GREEN}${C_BOLD}▸ %s${C_RESET}" "${items[$i]}"
        else
            printf "${C_WHITE}  %s${C_RESET}" "${items[$i]}"
        fi
    done

    # Help bar
    _move_to $((height+2)) 2
    printf "${C_GRAY}  [↑↓] Navigate  [Enter] Select  [Esc/q] Back${C_RESET}"
}

# ── Main Menu ─────────────────────────────────────────────────────
MENU_SELECTED=0

show_main_menu() {
    local -a items=(
        "Appearance"
        "Metrics"
        "Network"
        "Power"
        "Performance"
        "Keyboard"
        "Time & Date"
        "Services"
        "About"
    )

    while true; do
        draw_menu "System Setup" "${items[@]}"

        local key
        key=$(read_key)

        case "$key" in
            up)
                MENU_SELECTED=$(( (MENU_SELECTED - 1 + ${#items[@]}) % ${#items[@]} ))
                ;;
            down)
                MENU_SELECTED=$(( (MENU_SELECTED + 1) % ${#items[@]}))
                ;;
            enter)
                case $MENU_SELECTED in
                    0) show_appearance_menu ;;
                    1) show_metrics_menu ;;
                    2) show_network_menu ;;
                    3) show_power_menu ;;
                    4) show_performance_menu ;;
                    5) show_keyboard_menu ;;
                    6) show_time_menu ;;
                    7) show_services_menu ;;
                    8) show_about ;;
                esac
                ;;
            q|escape|ctrl-c)
                return 0
                ;;
        esac
    done
}

# ── Appearance Menu ───────────────────────────────────────────────
show_appearance_menu() {
    local -a items=(
        "Color Mode: $(config_get 'color_mode')"
        "Dashboard Layout: $(config_get 'dashboard_mode')"
        "Show Title: $(config_get 'show_title')"
        "Show Border: $(config_get 'show_border')"
        "Back"
    )
    local sel=0

    while true; do
        draw_menu "Appearance" "${items[@]}"

        local key
        key=$(read_key)

        case "$key" in
            up)   sel=$(( (sel - 1 + ${#items[@]}) % ${#items[@]} )) ;;
            down) sel=$(( (sel + 1) % ${#items[@]} )) ;;
            enter)
                case $sel in
                    0)  # Color mode cycle
                        local modes=("auto" "truecolor" "256" "16" "mono")
                        local cur
                        cur=$(config_get "color_mode")
                        local idx=0
                        for i in "${!modes[@]}"; do [[ "${modes[$i]}" == "$cur" ]] && idx=$i; done
                        idx=$(( (idx + 1) % ${#modes[@]} ))
                        config_set "color_mode" "${modes[$idx]}" 2>/dev/null || true
                        items[0]="Color Mode: ${modes[$idx]}"
                        ;;
                    1)  # Dashboard mode cycle
                        local modes=("full" "minimal" "compact")
                        local cur
                        cur=$(config_get "dashboard_mode")
                        local idx=0
                        for i in "${!modes[@]}"; do [[ "${modes[$i]}" == "$cur" ]] && idx=$i; done
                        idx=$(( (idx + 1) % ${#modes[@]} ))
                        config_set "dashboard_mode" "${modes[$idx]}" 2>/dev/null || true
                        items[1]="Dashboard Layout: ${modes[$idx]}"
                        ;;
                    2|3)  # Toggle boolean
                        local keys=("show_title" "show_border")
                        local keyname="${keys[$((sel-2))]}"
                        local cur
                        cur=$(config_get "$keyname")
                        if [[ "$cur" == "true" ]]; then
                            config_set "$keyname" "false" 2>/dev/null || true
                            items[$sel]="${items[$sel]//: true/: false}"
                        else
                            config_set "$keyname" "true" 2>/dev/null || true
                            items[$sel]="${items[$sel]//: false/: true}"
                        fi
                        ;;
                    4) return 0 ;;
                esac
                ;;
            q|escape)
                return 0
                ;;
        esac
    done
}

# ── Metrics Menu ──────────────────────────────────────────────────
show_metrics_menu() {
    local -a items=(
        "CPU Monitoring: $(config_get 'show_cpu')"
        "RAM Monitoring: $(config_get 'show_ram')"
        "GPU Monitoring: $(config_get 'show_gpu')"
        "Temperature: $(config_get 'show_temp')"
        "Network: $(config_get 'show_network')"
        "Battery: $(config_get 'show_battery')"
        "Disk: $(config_get 'show_disk')"
        "Back"
    )
    local sel=0

    while true; do
        draw_menu "Metrics" "${items[@]}"

        local key
        key=$(read_key)

        case "$key" in
            up)   sel=$(( (sel - 1 + ${#items[@]}) % ${#items[@]} )) ;;
            down) sel=$(( (sel + 1) % ${#items[@]} )) ;;
            enter)
                if [[ $sel -eq $((${#items[@]}-1)) ]]; then
                    return 0
                fi
                local keys=("show_cpu" "show_ram" "show_gpu" "show_temp" "show_network" "show_battery" "show_disk")
                local keyname="${keys[$sel]}"
                local cur
                cur=$(config_get "$keyname")
                if [[ "$cur" == "true" ]]; then
                    config_set "$keyname" "false" 2>/dev/null || true
                    items[$sel]="${items[$sel]//: true/: false}"
                else
                    config_set "$keyname" "true" 2>/dev/null || true
                    items[$sel]="${items[$sel]//: false/: true}"
                fi
                ;;
            q|escape)
                return 0
                ;;
        esac
    done
}

# ── Network Menu ──────────────────────────────────────────────────
show_network_menu() {
    local iface ssid ip state dns_mode
    iface=$(ip route show default 2>/dev/null | awk '{print $5}' | head -1 || echo "N/A")
    ssid=""
    if command -v iw &>/dev/null; then
        ssid=$(iw dev "$iface" link 2>/dev/null | grep "SSID:" | awk '{print $2}' || echo "")
    fi
    ip=$(ip -4 addr show "$iface" 2>/dev/null | grep inet | awk '{print $2}' | cut -d/ -f1 || echo "N/A")
    state=$(cat "/sys/class/net/$iface/operstate" 2>/dev/null || echo "unknown")
    dns_mode=$(config_get "dns_mode")

    local -a items=(
        "Interface: $iface"
        "SSID: ${ssid:-Disconnected}"
        "IP: $ip"
        "State: $state"
        "DNS Mode: $dns_mode"
        "Back"
    )
    local sel=0

    while true; do
        draw_menu "Network" "${items[@]}"

        local key
        key=$(read_key)

        case "$key" in
            up)   sel=$(( (sel - 1 + ${#items[@]}) % ${#items[@]} )) ;;
            down) sel=$(( (sel + 1) % ${#items[@]} )) ;;
            enter)
                if [[ $sel -eq 4 ]]; then
                    # Cycle DNS mode
                    local modes=("cloudflare" "automatic" "custom")
                    local cur
                    cur=$(config_get "dns_mode")
                    local idx=0
                    for i in "${!modes[@]}"; do [[ "${modes[$i]}" == "$cur" ]] && idx=$i; done
                    idx=$(( (idx + 1) % ${#modes[@]} ))
                    config_set "dns_mode" "${modes[$idx]}" 2>/dev/null || true
                    items[4]="DNS Mode: ${modes[$idx]}"
                elif [[ $sel -eq $((${#items[@]}-1)) ]]; then
                    return 0
                fi
                ;;
            q|escape)
                return 0
                ;;
        esac
    done
}

# ── Power Menu ────────────────────────────────────────────────────
show_power_menu() {
    local pwr_action lid_action
    pwr_action=$(config_get "power_button_action")
    lid_action=$(config_get "lid_action")

    local -a items=(
        "Power Button: $pwr_action"
        "Lid Action: $lid_action"
        "Shutdown"
        "Reboot"
        "Suspend"
        "Display Off"
        "Back"
    )
    local sel=0

    while true; do
        draw_menu "Power" "${items[@]}"

        local key
        key=$(read_key)

        case "$key" in
            up)   sel=$(( (sel - 1 + ${#items[@]}) % ${#items[@]} )) ;;
            down) sel=$(( (sel + 1) % ${#items[@]} )) ;;
            enter)
                case $sel in
                    0)  # Power button action cycle
                        local actions=("display-off" "suspend" "shutdown" "ask")
                        local cur
                        cur=$(config_get "power_button_action")
                        local idx=0
                        for i in "${!actions[@]}"; do [[ "${actions[$i]}" == "$cur" ]] && idx=$i; done
                        idx=$(( (idx + 1) % ${#actions[@]} ))
                        config_set "power_button_action" "${actions[$idx]}" 2>/dev/null || true
                        items[0]="Power Button: ${actions[$idx]}"
                        ;;
                    1)  # Lid action cycle
                        local actions=("suspend" "display-off" "nothing" "ask")
                        local cur
                        cur=$(config_get "lid_action")
                        local idx=0
                        for i in "${!actions[@]}"; do [[ "${actions[$i]}" == "$cur" ]] && idx=$i; done
                        idx=$(( (idx + 1) % ${#actions[@]} ))
                        config_set "lid_action" "${actions[$idx]}" 2>/dev/null || true
                        items[1]="Lid Action: ${actions[$idx]}"
                        ;;
                    2) _setup_cleanup; sudo systemctl poweroff ;;
                    3) _setup_cleanup; sudo systemctl reboot ;;
                    4) _setup_cleanup; sudo systemctl suspend ;;
                    5) _setup_cleanup; system-off 2>/dev/null || true ;;
                    6) return 0 ;;
                esac
                ;;
            q|escape)
                return 0
                ;;
        esac
    done
}

# ── Performance Menu ──────────────────────────────────────────────
show_performance_menu() {
    local swappiness cpu_governor
    swappiness=$(cat /proc/sys/vm/swappiness 2>/dev/null || echo "?")
    cpu_governor=$(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo "N/A")

    local -a items=(
        "Swappiness: $swappiness"
        "CPU Governor: $cpu_governor"
        "Back"
    )
    local sel=0

    while true; do
        draw_menu "Performance" "${items[@]}"

        local key
        key=$(read_key)

        case "$key" in
            up)   sel=$(( (sel - 1 + ${#items[@]}) % ${#items[@]} )) ;;
            down) sel=$(( (sel + 1) % ${#items[@]} )) ;;
            enter)
                if [[ $sel -eq $((${#items[@]}-1)) ]]; then
                    return 0
                fi
                ;;
            q|escape)
                return 0
                ;;
        esac
    done
}

# ── Keyboard Menu ─────────────────────────────────────────────────
show_keyboard_menu() {
    local keymap
    keymap=$(grep "^KEYMAP=" /etc/vconsole.conf 2>/dev/null | cut -d= -f2 || echo "us")

    local -a items=(
        "Keymap: $keymap"
        "Back"
    )
    local sel=0

    while true; do
        draw_menu "Keyboard" "${items[@]}"

        local key
        key=$(read_key)

        case "$key" in
            up)   sel=$(( (sel - 1 + ${#items[@]}) % ${#items[@]} )) ;;
            down) sel=$(( (sel + 1) % ${#items[@]} )) ;;
            enter)
                if [[ $sel -eq $((${#items[@]}-1)) ]]; then
                    return 0
                fi
                ;;
            q|escape)
                return 0
                ;;
        esac
    done
}

# ── Time & Date Menu ──────────────────────────────────────────────
show_time_menu() {
    local tz hostname_val
    tz=$(readlink /etc/localtime 2>/dev/null | sed 's|/usr/share/zoneinfo/||' || echo "?")
    hostname_val=$(hostname 2>/dev/null || echo "?")

    local -a items=(
        "Timezone: $tz"
        "Hostname: $hostname_val"
        "NTP: $(timedatectl show --property=NTP --value 2>/dev/null || echo "?")"
        "Back"
    )
    local sel=0

    while true; do
        draw_menu "Time & Date" "${items[@]}"

        local key
        key=$(read_key)

        case "$key" in
            up)   sel=$(( (sel - 1 + ${#items[@]}) % ${#items[@]} )) ;;
            down) sel=$(( (sel + 1) % ${#items[@]} )) ;;
            enter)
                if [[ $sel -eq $((${#items[@]}-1)) ]]; then
                    return 0
                fi
                ;;
            q|escape)
                return 0
                ;;
        esac
    done
}

# ── Services Menu ─────────────────────────────────────────────────
show_services_menu() {
    local nm_status sshd_status
    nm_status=$(systemctl is-active NetworkManager 2>/dev/null || echo "inactive")
    sshd_status=$(systemctl is-active sshd 2>/dev/null || echo "inactive")

    local -a items=(
        "NetworkManager: $nm_status"
        "SSHD: $sshd_status"
        "Back"
    )
    local sel=0

    while true; do
        draw_menu "Services" "${items[@]}"

        local key
        key=$(read_key)

        case "$key" in
            up)   sel=$(( (sel - 1 + ${#items[@]}) % ${#items[@]} )) ;;
            down) sel=$(( (sel + 1) % ${#items[@]} )) ;;
            enter)
                if [[ $sel -eq $((${#items[@]}-1)) ]]; then
                    return 0
                fi
                ;;
            q|escape)
                return 0
                ;;
        esac
    done
}

# ── About ─────────────────────────────────────────────────────────
show_about() {
    clear_screen
    local width=50
    local height=12
    draw_box "About" 3 2 "$width" "$height"

    _move_to 5 4
    printf "${C_BOLD}${C_CYAN}Arch Custom CLI${C_RESET}"
    _move_to 7 4
    printf "${C_WHITE}Version: 1.0.0${C_RESET}"
    _move_to 9 4
    printf "${C_WHITE}Kernel: $(uname -r)${C_RESET}"
    _move_to 11 4
    printf "${C_WHITE}Arch: $(uname -m)${C_RESET}"
    _move_to 13 4
    printf "${C_GRAY}Minimal • Fast • Secure${C_RESET}"

    _move_to $((height+3)) 2
    printf "${C_GRAY}  Press any key to return${C_RESET}"

    read_key > /dev/null 2>&1 || true
    sleep 0.3
}

# ── Main ──────────────────────────────────────────────────────────
main() {
    _setup_init
    show_main_menu
    _setup_cleanup
}

main "$@"
