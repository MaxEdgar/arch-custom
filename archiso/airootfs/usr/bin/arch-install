}

# ── Step 16: Desktop / Window Manager Selection ──────────────────
step_desktop() {
    step "16/24 — Desktop / Window Manager"

    local desktops=("hyprland" "sway" "i3" "gnome" "kde" "xfce" "cinnamon" "mate" "lxqt" "openbox" "bspwm" "dwm" "none")
    local labels=(
        "Hyprland (Wayland, tiling)"
        "Sway (Wayland, i3-compatible)"
        "i3 (X11, tiling)"
        "GNOME (Wayland/X11, full DE)"
        "KDE Plasma (Wayland/X11, full DE)"
        "XFCE (X11, lightweight DE)"
        "Cinnamon (X11, traditional DE)"
        "MATE (X11, classic DE)"
        "LXQt (X11, ultra-light DE)"
        "Openbox (X11, minimal WM)"
        "bspwm (X11, tiling WM)"
        "dwm (X11, suckless WM)"
        "No desktop (CLI only)"
    )

    local list_args=()
    for i in "${!desktops[@]}"; do
        list_args+=("$i" "${labels[$i]}")
    done

    local choice
    choice=$(whiptail --title "$INSTALLER_NAME" --menu "Select desktop environment:" 24 70 13 "${list_args[@]}" 3>&1 1>&2 2>&3) || return 0

    set_conf "desktop" "${desktops[$choice]}"
    info "Desktop: ${desktops[$choice]}"
}

# ── Step 17: Essential Package Selection ──────────────────────────
step_packages() {
    step "17/24 — Essential Packages"

    local pkg_categories=(
        "browsers:Browsers:firefox chromium"
        "terminal:Terminal Emulators:kitty alacritty foot"
        "editors:Editors:neovim vim nano"
        "git:Git + Tools:git"
        "dev:Development:gcc make cmake"
        "office:Office:libreoffice-fresh"
        "media:Media Players:mpv celluloid"
        "image:Image Tools:gimp inkscape"
        "archive:Archive Tools:zip unzip unrar"
        "ssh:SSH:openssh"
        "shell:Shell Enhancements:bash-completion zsh-completions fish-completions"
        "utils:Utilities:htop btop tmux fzf ripgrep fd bat eza"
        "fonts:Fonts:noto-fonts noto-fonts-cjk noto-fonts-emoji"
        "security:Security:gnupg pass"
    )

    local selections=()
    for cat in "${pkg_categories[@]}"; do
        IFS=':' read -r key label pkgs <<< "$cat"
        selections+=("$key" "$label" "ON")
    done

    local choices
    choices=$(whiptail --title "$INSTALLER_NAME" --checklist "Select package groups to install:" 24 70 14 "${selections[@]}" 3>&1 1>&2 2>&3) || return 0

    # Parse selected categories
    local selected_pkgs=""
    for cat in "${pkg_categories[@]}"; do
        IFS=':' read -r key label pkgs <<< "$cat"
        if echo "$choices" | grep -q "\"$key\""; then
            selected_pkgs="$selected_pkgs $pkgs"
        fi
    done

    set_conf "extra_packages" "$selected_pkgs"
    info "Extra packages: $selected_pkgs"
}

# ── Step 18: Review Before Install ───────────────────────────────
step_review() {
    step "18/24 — Review Configuration"

    echo -e "\n${BOLD}═══════════════════════════════════════════════════════════════${NC}"
    echo -e "${BOLD}  INSTALLATION SUMMARY${NC}"
    echo -e "${BOLD}═══════════════════════════════════════════════════════════════${NC}"
    echo -e ""
    echo -e "  ${CYAN}Keyboard:${NC}    $(get_conf keyboard_layout)"
    echo -e "  ${CYAN}Locale:${NC}      $(get_conf locale)"
    echo -e "  ${CYAN}Timezone:${NC}    $(get_conf timezone)"
    echo -e "  ${CYAN}Hostname:${NC}    $(get_conf hostname)"
    echo -e "  ${CYAN}Username:${NC}    $(get_conf username)"
    echo -e "  ${CYAN}Network:${NC}     $(get_conf network_manager)"
    echo -e "  ${CYAN}Disk:${NC}        $(get_conf disk)"
    echo -e "  ${CYAN}Partition:${NC}   $(get_conf partition_mode)"
    echo -e "  ${CYAN}Filesystem:${NC}  $(get_conf filesystem)"
    echo -e "  ${CYAN}Swap:${NC}        $(get_conf swap_type)"
    echo -e "  ${CYAN}Bootloader:${NC}  $(get_conf bootloader)"
    echo -e "  ${CYAN}Kernel:${NC}      $(get_conf kernel)"
    echo -e "  ${CYAN}Microcode:${NC}   $(get_conf microcode)"
    echo -e "  ${CYAN}GPU:${NC}         $(get_conf gpu_driver)"
    echo -e "  ${CYAN}Audio:${NC}       $(get_conf audio)"
    echo -e "  ${CYAN}Desktop:${NC}     $(get_conf desktop)"
    echo -e ""
    echo -e "${BOLD}═══════════════════════════════════════════════════════════════${NC}"

    if ! confirm "Proceed with installation?"; then
        warn "Installation cancelled by user."
        return 1
    fi
}

# ── Step 19-23: Perform Installation ─────────────────────────────
perform_install() {
    step "19/24 — Partitioning Disk"

    local disk partition_mode filesystem swap_type bootloader

    disk=$(get_conf "disk")
    partition_mode=$(get_conf "partition_mode")
    filesystem=$(get_conf "filesystem")
    swap_type=$(get_conf "swap_type")
    bootloader=$(get_conf "bootloader")

    [[ -z "$disk" ]] && die "No disk selected"

    # Create new partition table
    info "Creating partition table on $disk..."
    case "$partition_mode" in
        auto-uefi)
            parted -s "$disk" mklabel gpt
            # ESP partition (512M)
            parted -s "$disk" mkpart ESP fat32 1MiB 513MiB
            parted -s "$disk" set 1 esp on
            # Root partition (rest)
            parted -s "$disk" mkpart root "$filesystem" 513MiB 100%

            sleep 2
            # Determine partition names
            if [[ "$disk" == *nvme* || "$disk" == *mmcblk* ]]; then
                ESP="${disk}p1"
                ROOT="${disk}p2"
            else
                ESP="${disk}1"
                ROOT="${disk}2"
            fi
            ;;
        auto-bios)
            parted -s "$disk" mklabel msdos
            parted -s "$disk" mkpart primary "$filesystem" 1MiB 513MiB
            parted -s "$disk" set 1 boot on
            parted -s "$disk" mkpart primary "$filesystem" 513MiB 100%

            sleep 2
            if [[ "$disk" == *nvme* || "$disk" == *mmcblk* ]]; then
                ESP="${disk}p1"
                ROOT="${disk}p2"
            else
                ESP="${disk}1"
                ROOT="${disk}2"
            fi
            ;;
        manual)
            die "Manual partitioning not yet supported in this mode. Please partition manually and re-run."
            ;;
    esac

    info "Formatting partitions..."
    mkfs.fat -F32 -n BOOT "$ESP" || die "Failed to format ESP"

    case "$filesystem" in
        ext4) mkfs.ext4 -L ROOT "$ROOT" || die "Failed to format root" ;;
        btrfs) mkfs.btrfs -f -L ROOT "$ROOT" || die "Failed to format root" ;;
        xfs) mkfs.xfs -f -L ROOT "$ROOT" || die "Failed to format root" ;;
        f2fs) mkfs.f2fs -f -L ROOT "$ROOT" || die "Failed to format root" ;;
    esac

    # ── Swap ──
    step "20/24 — Configuring Swap"

    case "$swap_type" in
        swapfile)
            # Will create after mounting
            set_conf "swap_file_path" "/swapfile"
            ;;
        zram)
            info "ZRAM will be configured post-install"
            ;;
        none)
            info "No swap configured"
            ;;
    esac

    # ── Mount ──
    step "21/24 — Mounting Filesystems"

    info "Mounting root..."
    mount "$ROOT" /mnt || die "Failed to mount root"

    info "Mounting ESP..."
    mkdir -p /mnt/boot
    mount "$ESP" /mnt/boot || die "Failed to mount ESP"

    if [[ "$swap_type" == "swapfile" ]]; then
        local swap_size
        swap_size=$(get_conf "swap_size")
        info "Creating swap file (${swap_size}M)..."
        dd if=/dev/zero of=/mnt/swapfile bs=1M count="${swap_size:-2048}" status=progress
        chmod 600 /mnt/swapfile
        mkswap /mnt/swapfile || die "Failed to create swap"
    fi

    # ── Pacstrap ──
    step "22/24 — Installing Base System"

    local kernel
    kernel=$(get_conf "kernel")
    local microcode
    microcode=$(get_conf "microcode")

    local base_pkgs="base $kernel $kernel-headers"
    [[ "$microcode" != "none" ]] && base_pkgs="$base_pkgs $microcode"
    base_pkgs="$base_pkgs linux-firmware nano sudo git networkmanager grub"

    info "Running pacstrap..."
    pacstrap /mnt $base_pkgs || die "pacstrap failed"

    # ── Fstab ──
    step "23/24 — Generating fstab"

    info "Generating fstab..."
    genfstab -U /mnt >> /mnt/etc/fstab

    if [[ "$swap_type" == "swapfile" ]]; then
        echo "/swapfile none swap defaults 0 0" >> /mnt/etc/fstab
    fi

    # ── Configure Installed System ──
    step "24/24 — Configuring System"

    # Write configuration to chroot script
    cat > /mnt/tmp/arch-install-config.sh << 'CONFSCRIPT'
#!/usr/bin/env bash
set -euo pipefail

CONF="/tmp/arch-install.conf"
conf_get() { grep "^${1}=" "$CONF" 2>/dev/null | cut -d= -f2- || echo ""; }

# Timezone
ln -sf "/usr/share/zoneinfo/$(conf_get timezone)" /etc/localtime
hwclock --systohc

# Locale
echo "$(conf_get locale)" > /etc/locale.conf
echo "$(conf_get locale) UTF-8" > /etc/locale.gen
locale-gen

# Hostname
echo "$(conf_get hostname)" > /etc/hostname

# Hosts
cat > /etc/hosts << EOF
127.0.0.1   localhost
::1         localhost
127.0.1.1   $(conf_get hostname)
EOF

# Keyboard
mkdir -p /etc/keyboard.d
echo "KEYMAP=$(conf_get keyboard_layout)" > /etc/vconsole.conf

# User
useradd -m -G wheel -s /bin/bash "$(conf_get username)"
echo "$(conf_get username):$(conf_get userpass)" | chpasswd
echo "root:$(conf_get rootpw)" | chpasswd

# Sudo
sed -i 's/^#\s*\(%wheel\s.*ALL=(ALL:ALL) ALL\)/\1/' /etc/sudoers

# Network
case "$(conf_get network_manager)" in
    NetworkManager) systemctl enable NetworkManager ;;
    systemd-networkd) systemctl enable systemd-networkd systemd-resolved ;;
    iwd) systemctl enable iwd ;;
esac

# Initramfs
mkinitcpio -P

# Bootloader
case "$(conf_get bootloader)" in
    grub*)
        grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=GRUB
        grub-install --target=i386-pc --recheck "$(conf_get disk)" 2>/dev/null || true
        grub-mkconfig -o /boot/grub/grub.cfg
        ;;
    systemd-boot)
        bootctl install
        ;;
esac

# Microcode in GRUB
if [[ "$(conf_get bootloader)" == grub* ]]; then
    # Re-generate grub with microcode
    grub-mkconfig -o /boot/grub/grub.cfg
fi

echo "System configuration complete."
CONFSCRIPT

    # Copy config into chroot
    cp "$CONF_FILE" /mnt/tmp/arch-install.conf
    chmod +x /mnt/tmp/arch-install-config.sh

    # Run configuration
    arch-chroot /mnt /tmp/arch-install-config.sh || die "System configuration failed"

    # Swap
    if [[ "$swap_type" == "swapfile" ]]; then
        arch-chroot /mnt swapon /swapfile 2>/dev/null || true
    fi

    # Cleanup
    rm -f /mnt/tmp/arch-install-config.sh
    rm -f /mnt/tmp/arch-install.conf

    # ── Done ──
    echo ""
    echo -e "${GREEN}${BOLD}╔══════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}${BOLD}║         ✅ INSTALLATION COMPLETE             ║${NC}"
    echo -e "${GREEN}${BOLD}╚══════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "  System installed to: ${BOLD}$(get_conf disk)${NC}"
    echo -e "  Username: ${BOLD}$(get_conf username)${NC}"
    echo -e "  Desktop: ${BOLD}$(get_conf desktop)${NC}"
    echo ""
    echo -e "  ${DIM}Log: $LOGFILE${NC}"

    if whiptail --title "$INSTALLER_NAME" --yesno "Installation complete!\n\nReboot now?" 10 50; then
        umount -R /mnt 2>/dev/null || true
        reboot
    else
        info "You may reboot when ready with: reboot"
    fi
}

# ── Main ──────────────────────────────────────────────────────────
main() {
    clear
    echo -e "${CYAN}${BOLD}"
    echo "╔══════════════════════════════════════════════╗"
    echo "║         Arch Custom Installer v${INSTALLER_VERSION}          ║"
    echo "║         Minimal • Fast • Safe                ║"
    echo "╚══════════════════════════════════════════════╝"
    echo -e "${NC}"

    # Create work directory
    mkdir -p "$WORK_DIR"
    : > "$CONF_FILE"

    # Steps 0-17: Configuration
    step_keyboard   || return 0
    step_locale     || return 0
    step_timezone   || return 0
    step_hostname   || return 0
    step_user       || return 0
    step_rootpw     || return 0
    step_network    || return 0
    step_disk       || return 0
    step_partition  || return 0
    step_filesystem || return 0
    step_swap       || return 0
    step_bootloader || return 0
    step_kernel     || return 0
    step_microcode  || return 0
    step_gpu        || return 0
    step_audio      || return 0
    step_desktop    || return 0
    step_packages   || return 0

    # Step 18: Review
    step_review || return 0

    # Steps 19-24: Perform installation
    perform_install
}

main "$@"
