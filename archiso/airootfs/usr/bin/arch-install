    done

    local choice
    choice=$(whiptail --title "$INSTALLER_NAME" --menu "Select bootloader:" 15 60 3 "${list_args[@]}" 3>&1 1>&2 2>&3) || return 0

    set_conf "bootloader" "${bootloaders[$choice]}"
    info "Bootloader: ${bootloaders[$choice]}"
}

# ── Step 12: Kernel Selection ────────────────────────────────────
step_kernel() {
    step "12/24 — Kernel"

    local kernels=("linux" "linux-lts" "linux-zen" "linux-hardened")
    local labels=("linux (latest)" "linux-lts (long-term support)" "linux-zen (performance)" "linux-hardened (security)")

    local list_args=()
    for i in "${!kernels[@]}"; do
        list_args+=("$i" "${labels[$i]}")
    done

    local choice
    choice=$(whiptail --title "$INSTALLER_NAME" --menu "Select kernel:" 15 60 4 "${list_args[@]}" 3>&1 1>&2 2>&3) || return 0

    set_conf "kernel" "${kernels[$choice]}"
    info "Kernel: ${kernels[$choice]}"
}

# ── Step 13: Microcode Selection ─────────────────────────────────
step_microcode() {
    step "13/24 — Microcode"

    local options=()
    local cpu_vendor
    cpu_vendor=$(lscpu | grep 'Vendor ID' | awk '{print $3}')

    case "$cpu_vendor" in
        GenuineIntel) options=("intel-ucode" "none") ;;
        AuthenticAMD) options=("amd-ucode" "none") ;;
        *) options=("intel-ucode" "amd-ucode" "none") ;;
    esac

    local labels=()
    for opt in "${options[@]}"; do
        case "$opt" in
            intel-ucode) labels+=("Intel microcode (recommended)") ;;
            amd-ucode) labels+=("AMD microcode (recommended)") ;;
            none) labels+=("No microcode") ;;
        esac
    done

    local list_args=()
    for i in "${!options[@]}"; do
        list_args+=("$i" "${labels[$i]}")
    done

    local choice
    choice=$(whiptail --title "$INSTALLER_NAME" --menu "Select microcode:" 15 60 3 "${list_args[@]}" 3>&1 1>&2 2>&3) || return 0

    set_conf "microcode" "${options[$choice]}"
    info "Microcode: ${options[$choice]}"
}

# ── Step 14: GPU/Graphics Setup ──────────────────────────────────
step_gpu() {
    step "14/24 — GPU / Graphics"

    local gpus=()
    local gpu_labels=()

    # Detect GPU
    local gpu_list
    gpu_list=$(lspci 2>/dev/null | grep -iE 'vga|3d|display' || true)

    if echo "$gpu_list" | grep -qi "nvidia"; then
        gpus+=("nvidia" "nouveau" "modesetting")
        gpu_labels+=("NVIDIA (proprietary)" "Nouveau (open-source)" "Modesetting (generic)")
    elif echo "$gpu_list" | grep -qi "amd\|radeon"; then
        gpus+=("amdgpu" "modesetting")
        gpu_labels+=("AMDGPU (recommended)" "Modesetting (generic)")
    elif echo "$gpu_list" | grep -qi "intel"; then
        gpus+=("intel" "modesetting")
        gpu_labels+=("Intel (xf86-video-intel)" "Modesetting (generic)")
    else
        gpus+=("modesetting" "vesa")
        gpu_labels+=("Modesetting (generic)" "VESA (fallback)")
    fi

    gpus+=("none")
    gpu_labels+=("No graphics driver")

    local list_args=()
    for i in "${!gpus[@]}"; do
        list_args+=("$i" "${gpu_labels[$i]}")
    done

    local choice
    choice=$(whiptail --title "$INSTALLER_NAME" --menu "Select GPU driver:" 18 60 8 "${list_args[@]}" 3>&1 1>&2 2>&3) || return 0

    set_conf "gpu_driver" "${gpus[$choice]}"
    info "GPU driver: ${gpus[$choice]}"
}

