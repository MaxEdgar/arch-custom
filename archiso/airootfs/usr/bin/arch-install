#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════
# Arch Custom Installer
# A minimal, fast, keyboard-friendly Arch Linux installer.
# Replaces archinstall with a modular, safe-by-default design.
# ═══════════════════════════════════════════════════════════════════
set -euo pipefail

# ── Constants ─────────────────────────────────────────────────────
INSTALLER_VERSION="1.0.0"
INSTALLER_NAME="Arch Custom Installer"
LOGFILE="/var/log/arch-install.log"
CONF_FILE="/tmp/arch-install.conf"
WORK_DIR="/tmp/arch-install"

# ── Colors ────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# ── Logging ───────────────────────────────────────────────────────
mkdir -p "$(dirname "$LOGFILE")"
log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOGFILE"; }
die() { echo -e "${RED}ERROR:${NC} $*" >&2; log "FATAL: $*"; exit 1; }
info() { echo -e "${GREEN}→${NC} $*"; log "INFO: $*"; }
warn() { echo -e "${YELLOW}!${NC} $*"; log "WARN: $*"; }
step() { echo -e "\n${CYAN}═══ $* ═══${NC}"; log "STEP: $*"; }

# ── Helpers ───────────────────────────────────────────────────────
confirm() {
    local msg="$1"
    echo -e "\n${BOLD}${YELLOW}CONFIRM:${NC} $msg"
    read -rp "Type YES to confirm: " ans
    [[ "$ans" == "YES" ]] || { echo -e "${RED}Aborted.${NC}"; return 1; }
}

set_conf() { echo "$2" >> "$CONF_FILE"; }
get_conf() { grep "^${1}=" "$CONF_FILE" 2>/dev/null | cut -d= -f2- || echo ""; }

# ── Step 0: Keyboard Layout ──────────────────────────────────────
step_keyboard() {
    step "0/24 — Keyboard Layout"

    local layouts=("us" "uk" "de" "fr" "es" "it" "pt" "nl" "se" "no" "dk" "fi" "jp" "kr" "cn" "br" "latam")
    local labels=("US English (QWERTY)" "UK English" "German (QWERTZ)" "French (AZERTY)" "Spanish" "Italian" "Portuguese" "Dutch" "Swedish" "Norwegian" "Danish" "Finnish" "Japanese" "Korean" "Chinese" "Brazilian" "Latin American")

    local list_args=()
    for i in "${!layouts[@]}"; do
        list_args+=("$i" "${labels[$i]}")
    done

    local choice
    choice=$(whiptail --title "$INSTALLER_NAME" --menu "Select keyboard layout:" 20 70 12 "${list_args[@]}" 3>&1 1>&2 2>&3) || return 0

    local layout="${layouts[$choice]}"
    set_conf "keyboard_layout" "$layout"

    # Apply immediately
    loadkeys "$layout" 2>/dev/null || true

    info "Keyboard layout: $layout"
}

# ── Step 1: Locale ───────────────────────────────────────────────
step_locale() {
    step "1/24 — Locale"

    local locales=("en_US.UTF-8" "en_GB.UTF-8" "de_DE.UTF-8" "fr_FR.UTF-8" "es_ES.UTF-8" "it_IT.UTF-8" "pt_BR.UTF-8" "ja_JP.UTF-8" "ko_KR.UTF-8" "zh_CN.UTF-8" "ru_RU.UTF-8")
    local list_args=()
    for i in "${!locales[@]}"; do
        list_args+=("$i" "${locales[$i]}")
    done

    local choice
    choice=$(whiptail --title "$INSTALLER_NAME" --menu "Select locale:" 20 60 10 "${list_args[@]}" 3>&1 1>&2 2>&3) || return 0

    local locale="${locales[$choice]}"
    set_conf "locale" "$locale"
    set_conf "locale_gen" "$locale"

    info "Locale: $locale"
}

# ── Step 2: Timezone ─────────────────────────────────────────────
step_timezone() {
    step "2/24 — Timezone"

    local tzones=("UTC" "US/Eastern" "US/Central" "US/Mountain" "US/Pacific" "Europe/London" "Europe/Berlin" "Europe/Paris" "Europe/Madrid" "Europe/Rome" "Asia/Tokyo" "Asia/Shanghai" "Asia/Seoul" "Asia/Kolkata" "Australia/Sydney" "America/Sao_Paulo")
    local list_args=()
    for i in "${!tzones[@]}"; do
        list_args+=("$i" "${tzones[$i]}")
    done

    local choice
    choice=$(whiptail --title "$INSTALLER_NAME" --menu "Select timezone:" 20 60 12 "${list_args[@]}" 3>&1 1>&2 2>&3) || return 0

    local tz="${tzones[$choice]}"
    set_conf "timezone" "$tz"

    info "Timezone: $tz"
}

# ── Step 3: Hostname ─────────────────────────────────────────────
step_hostname() {
    step "3/24 — Hostname"

    local hostname
    hostname=$(whiptail --title "$INSTALLER_NAME" --inputbox "Enter hostname:" 10 50 "arch" 3>&1 1>&2 2>&3) || return 0

    [[ -z "$hostname" ]] && hostname="arch"
    set_conf "hostname" "$hostname"

    info "Hostname: $hostname"
}

# ── Step 4: User Creation ────────────────────────────────────────
step_user() {
    step "4/24 — User Creation"

    local username
    username=$(whiptail --title "$INSTALLER_NAME" --inputbox "Enter username:" 10 50 "max" 3>&1 1>&2 2>&3) || return 0

    [[ -z "$username" ]] && { warn "Username cannot be empty"; return 1; }

    local userpass
    userpass=$(whiptail --title "$INSTALLER_NAME" --passwordbox "Enter password for $username:" 10 50 3>&1 1>&2 2>&3) || return 0

    local userpass2
    userpass2=$(whiptail --title "$INSTALLER_NAME" --passwordbox "Confirm password for $username:" 10 50 3>&1 1>&2 2>&3) || return 0

    [[ "$userpass" != "$userpass2" ]] && { warn "Passwords do not match"; return 1; }
    [[ -z "$userpass" ]] && { warn "Password cannot be empty"; return 1; }

    set_conf "username" "$username"
    set_conf "userpass" "$userpass"

    info "User: $username"
}

# ── Step 5: Root Password ────────────────────────────────────────
step_rootpw() {
    step "5/24 — Root Password"

    local rootpw
    rootpw=$(whiptail --title "$INSTALLER_NAME" --passwordbox "Enter root password:" 10 50 3>&1 1>&2 2>&3) || return 0

    local rootpw2
    rootpw2=$(whiptail --title "$INSTALLER_NAME" --passwordbox "Confirm root password:" 10 50 3>&1 1>&2 2>&3) || return 0

    [[ "$rootpw" != "$rootpw2" ]] && { warn "Passwords do not match"; return 1; }
    [[ -z "$rootpw" ]] && { warn "Root password cannot be empty"; return 1; }

    set_conf "rootpw" "$rootpw"

    info "Root password set"
}

# ── Step 6: Network Configuration ────────────────────────────────
step_network() {
    step "6/24 — Network Configuration"

    local methods=("NetworkManager" "systemd-networkd" "iwd")
    local labels=("NetworkManager (recommended)" "systemd-networkd" "iwd")

    local list_args=()
    for i in "${!methods[@]}"; do
        list_args+=("$i" "${labels[$i]}")
    done

    local choice
    choice=$(whiptail --title "$INSTALLER_NAME" --menu "Select network manager:" 15 60 3 "${list_args[@]}" 3>&1 1>&2 2>&3) || return 0

    set_conf "network_manager" "${methods[$choice]}"
    info "Network: ${methods[$choice]}"
}

# ── Step 7: Disk Selection ───────────────────────────────────────
step_disk() {
    step "7/24 — Disk Selection"

    info "Detecting disks..."

    local -a disks=()
    local -a disk_info=()

    while IFS= read -r line; do
        local name size model fstype mountpoint
        name=$(echo "$line" | awk '{print $1}')
        size=$(echo "$line" | awk '{print $2}')
        model=$(echo "$line" | awk '{print $3}')
        fstype=$(echo "$line" | awk '{print $4}')
        mountpoint=$(echo "$line" | awk '{print $5}')

        # Skip loop devices and CD-ROMs
        [[ "$name" == loop* || "$name" == sr* ]] && continue

        local dev="/dev/$name"
        [[ -b "$dev" ]] || continue

        # Skip if mounted
        [[ -n "$mountpoint" ]] && continue

        disks+=("$dev")
        disk_info+=("$dev  ${size:-?}  ${model:-unknown}  ${fstype:-?}")
    done < <(lsblk -d -n -o NAME,SIZE,MODEL,FSTYPE,MOUNTPOINTS 2>/dev/null)

    [[ ${#disks[@]} -eq 0 ]] && { warn "No installable disks found"; return 1; }

    # Show disk info
    echo -e "\n${BOLD}Available Disks:${NC}"
    echo -e "${DIM}DEVICE   SIZE      MODEL              FS${NC}"
    for info in "${disk_info[@]}"; do
        echo -e "  $info"
    done

    local list_args=()
    for i in "${!disks[@]}"; do
        list_args+=("$i" "${disk_info[$i]}")
    done

    local choice
    choice=$(whiptail --title "$INSTALLER_NAME" --menu "Select installation disk:" 20 70 10 "${list_args[@]}" 3>&1 1>&2 2>&3) || return 0

    local selected_disk="${disks[$choice]}"

    # Show WARNING
    local disk_size
    disk_size=$(lsblk -d -n -o SIZE "$selected_disk" 2>/dev/null || echo "unknown")

    echo -e "\n${RED}${BOLD}╔══════════════════════════════════════════════╗${NC}"
    echo -e "${RED}${BOLD}║              ⚠  WARNING  ⚠                  ║${NC}"
    echo -e "${RED}${BOLD}╚══════════════════════════════════════════════╝${NC}"
    echo -e "\n${BOLD}The following disk will be modified:${NC}"
    echo -e "  Device: ${RED}${selected_disk}${NC}"
    echo -e "  Size:   ${disk_size}"
    echo -e ""
    echo -e "${RED}ALL DATA ON THIS DISK WILL BE DESTROYED.${NC}"
    echo -e ""

    if ! confirm "I understand all data on $selected_disk will be erased"; then
        return 1
    fi

    set_conf "disk" "$selected_disk"
    info "Selected disk: $selected_disk"
}

# ── Step 8: Partitioning ─────────────────────────────────────────
step_partition() {
    step "8/24 — Partitioning"

    local disk
    disk=$(get_conf "disk")
    [[ -z "$disk" ]] && { warn "No disk selected"; return 1; }

    local modes=("auto-uefi" "auto-bios" "manual")
    local labels=("Auto UEFI (GPT + ESP)" "Auto BIOS (MBR)" "Manual partitioning")

    local list_args=()
    for i in "${!modes[@]}"; do
        list_args+=("$i" "${labels[$i]}")
    done

    local choice
    choice=$(whiptail --title "$INSTALLER_NAME" --menu "Partitioning mode:" 15 60 3 "${list_args[@]}" 3>&1 1>&2 2>&3) || return 0

    set_conf "partition_mode" "${modes[$choice]}"
    info "Partitioning: ${modes[$choice]}"
}

# ── Step 9: Filesystem Selection ─────────────────────────────────
step_filesystem() {
    step "9/24 — Filesystem"

    local fss=("ext4" "btrfs" "xfs" "f2fs")
    local labels=("ext4 (stable, default)" "btrfs (snapshots, compression)" "xfs (performance)" "f2fs (flash-optimized)")

    local list_args=()
    for i in "${!fss[@]}"; do
        list_args+=("$i" "${labels[$i]}")
    done

    local choice
    choice=$(whiptail --title "$INSTALLER_NAME" --menu "Select root filesystem:" 15 60 4 "${list_args[@]}" 3>&1 1>&2 2>&3) || return 0

    set_conf "filesystem" "${fss[$choice]}"
    info "Filesystem: ${fss[$choice]}"
}

# ── Step 10: Swap Configuration ──────────────────────────────────
step_swap() {
    step "10/24 — Swap"

    local swap_modes=("swapfile" "swap-partition" "zram" "none")
    local labels=("Swap file (flexible)" "Dedicated swap partition" "ZRAM (compressed, fast)" "No swap")

    local list_args=()
    for i in "${!swap_modes[@]}"; do
        list_args+=("$i" "${labels[$i]}")
    done

    local choice
    choice=$(whiptail --title "$INSTALLER_NAME" --menu "Swap configuration:" 15 60 4 "${list_args[@]}" 3>&1 1>&2 2>&3) || return 0

    local swap_type="${swap_modes[$choice]}"
    set_conf "swap_type" "$swap_type"

    if [[ "$swap_type" == "swapfile" ]]; then
        local mem_total
        mem_total=$(awk '/^MemTotal/ {printf "%.0f", $2/1024}' /proc/meminfo)
        local swap_size
        swap_size=$(whiptail --title "$INSTALLER_NAME" --inputbox "Swap file size in MB:" 10 50 "$mem_total" 3>&1 1>&2 2>&3) || return 0
        set_conf "swap_size" "$swap_size"
    fi

    info "Swap: $swap_type"
}

